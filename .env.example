# Production origin without a trailing slash.
# Used for canonical URLs, Open Graph URLs, and the generated sitemap.
# Leave empty until the domain is approved.
VITE_SITE_URL=

# HTTPS endpoint that accepts POST application/json:
# { "name", "email", "company", "inquiryType", "message" }
# Return HTTP 2xx only after the message is stored or delivered.
# Leave empty to keep the contact form in its explicit not-configured state.
VITE_CONTACT_ENDPOINT=
